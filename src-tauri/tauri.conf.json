{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-dk",
  "version": "0.1.8",
  "identifier": "com.goyac.deepseek-harness-desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "dsh-dk",
        "width": 1360,
        "height": 900,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3OUQyMjBDRjRDOTREQUIKUldTclRjbjBEQ0tkaDYramxOd2M1M2NwVnFIR3F0cXNhMStkYXdHaWhmYkRFY3NoVSsrK0lML0gK",
      "endpoints": [
        "https://github.com/GoyacJ/deepseek-harness-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
